{
  "name": "ComplexEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug, unique per tenant"
    },
    "description": {
      "type": "string",
      "description": "Rich text description (HTML)"
    },
    "summary": {
      "type": "string",
      "description": "Short plain-text summary"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the event banner image"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string",
      "description": "Physical address or venue name"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "tbc", "closed"],
      "description": "Event visibility/lifecycle status"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier"
    },
    "available_seats": {
      "type": "number",
      "description": "Total capacity (null = unlimited)"
    }
  },
  "required": ["title", "slug"]
}