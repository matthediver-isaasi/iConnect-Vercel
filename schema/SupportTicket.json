{
    "name": "SupportTicket",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "bug",
          "feature_request",
          "how_to",
          "general"
        ],
        "description": "Type of support ticket"
      },
      "subject": {
        "type": "string",
        "description": "Ticket subject/title"
      },
      "description": {
        "type": "string",
        "description": "Detailed description of the issue or request"
      },
      "severity": {
        "type": "string",
        "enum": [
          "minor",
          "moderate",
          "major",
          "critical"
        ],
        "default": "moderate",
        "description": "Severity level of the issue"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "closed"
        ],
        "default": "open",
        "description": "Current status of the ticket"
      },
      "priority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "urgent"
        ],
        "default": "medium",
        "description": "Priority level"
      },
      "submitter_email": {
        "type": "string",
        "description": "Email of the person who submitted the ticket"
      },
      "submitter_name": {
        "type": "string",
        "description": "Name of the person who submitted the ticket"
      },
      "assigned_to": {
        "type": "string",
        "description": "Admin/developer assigned to this ticket"
      },
      "attachments": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Array of file URLs attached to the ticket"
      },
      "resolution_notes": {
        "type": "string",
        "description": "Final resolution notes when ticket is closed"
      },
      "area": {
        "type": "string",
        "description": "Support area this ticket belongs to (tenant-configured)"
      },
      "resolved_at": {
        "type": "string",
        "format": "date-time",
        "description": "When the ticket was last marked resolved (cleared on reopen)"
      },
      "closed_reason": {
        "type": "string",
        "enum": ["manual", "auto"],
        "description": "Whether the ticket was closed manually or auto-closed by the cron"
      },
      "auto_close_warning_sent_at": {
        "type": "string",
        "format": "date-time",
        "description": "When the auto-close warning email was sent (cleared on reopen)"
      },
      "satisfaction_rating": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "description": "Submitter's 1-5 satisfaction rating"
      },
      "satisfaction_comment": {
        "type": "string",
        "description": "Optional free-text feedback from the submitter"
      },
      "satisfaction_rated_at": {
        "type": "string",
        "format": "date-time",
        "description": "When the satisfaction rating was last submitted/updated"
      }
    },
    "required": [
      "type",
      "subject",
      "description",
      "submitter_email",
      "submitter_name"
    ]
  }