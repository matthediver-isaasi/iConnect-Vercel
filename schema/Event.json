{
    "name": "Event",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Event name from Backstage"
      },
      "description": {
        "type": "string"
      },
      "program_tag": {
        "type": "string",
        "description": "Program/category tag from Backstage"
      },
      "start_date": {
        "type": "string",
        "format": "date-time"
      },
      "end_date": {
        "type": "string",
        "format": "date-time"
      },
      "location": {
        "type": "string"
      },
      "ticket_price": {
        "type": "number"
      },
      "available_seats": {
        "type": "number"
      },
      "is_unlimited_registration": {
        "type": "boolean",
        "description": "If true, event has no seat limit (open registration). If false/null, use available_seats to track capacity."
      },
      "backstage_event_id": {
        "type": "string",
        "description": "Zoho Backstage Event ID"
      },
      "backstage_ticket_type_id": {
        "type": "string",
        "description": "Zoho Backstage ticket type ID for this event's main ticket"
      },
      "backstage_public_url": {
        "type": "string",
        "description": "Public Backstage event page URL for attendees"
      },
      "image_url": {
        "type": "string"
      },
      "image_focal_point": {
        "type": "object",
        "description": "Focal point coordinates for the event image (percentages). Used for smart cropping.",
        "properties": {
          "x": {
            "type": "number",
            "description": "Horizontal focal point percentage (0-100)"
          },
          "y": {
            "type": "number", 
            "description": "Vertical focal point percentage (0-100)"
          }
        }
      },
      "last_synced": {
        "type": "string",
        "format": "date-time",
        "description": "Last sync from Backstage"
      },
      "show_ticket_availability": {
        "type": "boolean",
        "description": "If true, show ticket class availability counts to users on the event details page"
      }
    },
    "required": [
      "title",
      "program_tag"
    ]
  }