{
    "name": "Form",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Form name"
      },
      "description": {
        "type": "string",
        "description": "Form description"
      },
      "slug": {
        "type": "string",
        "description": "URL-friendly identifier for the form"
      },
      "layout_type": {
        "type": "string",
        "enum": [
          "standard",
          "card_swipe"
        ],
        "default": "standard",
        "description": "Form layout: standard (all fields at once) or card_swipe (one field per card)"
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "default": [],
        "description": "Array of form field definitions"
      },
      "submit_button_text": {
        "type": "string",
        "default": "Submit",
        "description": "Text for the submit button"
      },
      "success_message": {
        "type": "string",
        "default": "Thank you for your submission!",
        "description": "Message shown after successful submission"
      },
      "redirect_url": {
        "type": "string",
        "description": "Optional URL to redirect to after submission"
      },
      "require_authentication": {
        "type": "boolean",
        "default": false,
        "description": "Whether users must be logged in to submit"
      },
      "is_active": {
        "type": "boolean",
        "default": true,
        "description": "Whether the form is currently active"
      },
      "submission_count": {
        "type": "number",
        "default": 0,
        "description": "Number of submissions received"
      },
      "is_application_form": {
        "type": "boolean",
        "default": false,
        "description": "Whether this is an application form that requires uniqueness validation"
      },
      "application_level": {
        "type": "string",
        "enum": [
          "member",
          "organization"
        ],
        "description": "For application forms: whether to check uniqueness at member or organization level"
      },
      "uniqueness_checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "field_id": {
              "type": "string",
              "description": "The ID of the field to check for uniqueness"
            },
            "check_mode": {
              "type": "string",
              "enum": ["full", "domain_only"],
              "default": "full",
              "description": "For email fields: full = entire email, domain_only = just the domain part"
            }
          }
        },
        "default": [],
        "description": "Array of field IDs that must be unique in existing submissions or database records"
      }
    },
    "required": [
      "name",
      "slug",
      "layout_type"
    ]
  }