              "content": {
                "html": "<p><span style=\"font-size: 20px;\">The BNMS Patient Video Library includes:</span></p><ul><li><p><span style=\"font-size: 20px;\">An introduction to Nuclear Medicine</span></p></li><li><p><span style=\"font-size: 20px;\">What happens during a Nuclear Medicine examination</span></p></li><li><p><span style=\"font-size: 20px;\">PET/CT scans</span></p></li><li><p><span style=\"font-size: 20px;\">PET/MRI scans</span></p></li><li><p><span style=\"font-size: 20px;\">Patient information videos</span></p></li><li><p><span style=\"font-size: 20px;\">Additional educational videos as they become available</span></p></li></ul><p></p>",
