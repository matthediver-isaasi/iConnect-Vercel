              "locked": false,
              "content": {
                "html": "<p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Sometimes watching a short video can help explain a procedure more clearly than reading about it.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">BNMS has brought together a collection of patient-friendly videos to help you understand nuclear medicine, prepare for your appointment and learn more about common scans and treatments.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Whether you're attending for your first appointment or supporting a family member, these videos are designed to answer common questions and help you feel more prepared.</span></p><p style=\"text-align: center;\"></p>",
                "colorRole": "default",
