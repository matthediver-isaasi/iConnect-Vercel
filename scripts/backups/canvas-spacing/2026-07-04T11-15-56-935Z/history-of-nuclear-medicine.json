              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\"><strong>Hal Anger</strong></span></p><p><span style=\"font-size: 20px;\">Hal Anger revolutionized the field of nuclear medicine with his development of the gamma camera in the late 1950s. He also developed the well counter, widely used in laboratory tests with small samples of radioactive materials.</span></p>",
                "colorRole": "default"
              },
