              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\"><strong>Ernest O. Lawrence</strong></span></p><p><span style=\"font-size: 20px;\">In 1929, Ernest O. Lawrence, working at the University of California at Berkeley, invented the cyclotron which could create a number of radioisotopes that are useful in biological and medical work</span></p>",
                "colorRole": "default"
              },
              "groupId": null,
              "anchorId": "",
              "fullWidth": false
            },
