              "locked": false,
              "content": {
                "html": "<p style=\"text-align: left;\"><span style=\"font-size: 20px;\">The British Nuclear Medicine Society brings together healthcare professionals from every discipline within nuclear medicine. Our Professional Groups and Committees provide opportunities to collaborate, share knowledge, influence best practice and support the continued development of the specialty.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">Whether your interests lie in clinical practice, education, professional standards, research or scientific innovation, becoming involved is an excellent way to contribute to the profession while developing your own knowledge, leadership skills and professional network.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">Many of our groups also help shape BNMS conferences, educational activities, national guidance and future developments across nuclear medicine.</span></p><p style=\"text-align: left;\"></p>",
                "colorRole": "default",
                "bulletIcon": "",
