              "content": {
                "html": "<p><span style=\"font-size: 20px;\">You may be eligible to claim tax relief if:</span></p><ul><li><p><span style=\"font-size: 20px;\">Your BNMS membership is required for your role or professional practice.</span></p></li><li><p><span style=\"font-size: 20px;\">You personally pay your membership subscription.</span></p></li><li><p><span style=\"font-size: 20px;\">Your employer does not reimburse your subscription fees.</span></p></li></ul><p></p>",
