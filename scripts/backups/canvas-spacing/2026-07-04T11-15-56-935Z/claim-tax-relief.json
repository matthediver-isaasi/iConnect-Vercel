              "locked": false,
              "content": {
                "html": "<p style=\"text-align: center;\"><span style=\"font-size: 20px;\">The British Nuclear Medicine Society is approved by HM Revenue &amp; Customs (HMRC), which means that eligible members may be able to claim tax relief on their annual membership subscription fees.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">This can help reduce the overall cost of your membership and may provide an additional financial benefit for eligible members.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Please note that eligibility is determined by HMRC and individual circumstances may vary.</span></p>",
                "colorRole": "default",
