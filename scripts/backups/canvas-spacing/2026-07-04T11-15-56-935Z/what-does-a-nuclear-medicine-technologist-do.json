                "paddingRight": 0,
                "paddingBottom": 0
              },
              "locked": false,
              "content": {
                "body": "<p><span style=\"font-size: 20px;\">Technologists work with some of the most advanced imaging technology available, including:</span></p><ul><li><p><span style=\"font-size: 20px;\">Gamma cameras.</span></p></li><li><p><span style=\"font-size: 20px;\">SPECT-CT systems.</span></p></li><li><p><span style=\"font-size: 20px;\">PET-CT scanners.</span></p></li><li><p><span style=\"font-size: 20px;\">Imaging software.</span></p></li><li><p><span style=\"font-size: 20px;\">Radiopharmaceutical technologies.</span></p></li></ul><p><span style=\"font-size: 20px;\">They combine technical expertise with knowledge of anatomy, physiology and disease to produce high-quality diagnostic images.</span></p><p></p>",
                "shadow": "md",
                "ctaHref": "#",
                "heading": "Imaging and technology",
                "ctaAlign": "right",
                "ctaLabel": "Learn more",
                "iconSize": 47,
                "imageAlt": "Imaging",
                "imageUrl": "https://vault.iconn.app/storage/v1/object/public/public-assets/ff2df806-b321-4254-b651-3af11fccf1db/uploads/1782479476309-466ic1g-imaging_and_technology.png",
