              "locked": false,
              "content": {
                "html": "<p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Nuclear Medicine Technologists, also known as Clinical Technologists or Healthcare Science Practitioners, play an essential role within the multidisciplinary nuclear medicine team.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">They combine scientific knowledge, advanced technology and compassionate patient care to support the diagnosis, monitoring and treatment of a wide range of medical conditions.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Working in hospitals and specialist centres across the UK, Nuclear Medicine Technologists use sophisticated imaging equipment and radiopharmaceuticals to help clinicians make accurate diagnoses and deliver targeted treatments.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">As imaging technology and molecular radiotherapy continue to evolve, the profession continues to grow, offering an exciting, varied and rewarding healthcare career.</span></p><p style=\"text-align: center;\"></p>",
                "colorRole": "default",
                "bulletIcon": "",
                "bulletIconSize": null,
                "bulletIconColor": "",
