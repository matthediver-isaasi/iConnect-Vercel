                "paddingRight": 0,
                "paddingBottom": 0
              },
              "locked": false,
              "content": {
                "body": "<p><span style=\"font-size: 20px;\">Nuclear Medicine Technologists work as part of a multidisciplinary healthcare team alongside doctors, physicists, nurses, radiopharmacists, scientists and radiographers.</span></p><p><span style=\"font-size: 20px;\">Many also contribute to:</span></p><ul><li><p><span style=\"font-size: 20px;\">Research.</span></p></li><li><p><span style=\"font-size: 20px;\">Clinical innovation.</span></p></li><li><p><span style=\"font-size: 20px;\">Service development.</span></p></li><li><p><span style=\"font-size: 20px;\">Education and training.</span></p></li><li><p><span style=\"font-size: 20px;\">Quality improvement.</span></p></li></ul><p><span style=\"font-size: 20px;\">Every day offers opportunities to improve patient care and support advances in nuclear medicine.</span></p><p></p>",
                "shadow": "md",
                "ctaHref": "#",
                "heading": "Teamwork and innovation",
