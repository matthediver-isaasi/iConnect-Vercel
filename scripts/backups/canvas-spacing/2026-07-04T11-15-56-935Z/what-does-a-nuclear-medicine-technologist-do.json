              "locked": false,
              "content": {
                "body": "<p><span style=\"font-size: 20px;\">Supporting patients is at the heart of the role.</span></p><p><span style=\"font-size: 20px;\">Nuclear Medicine Technologists:</span></p><ul><li><p><span style=\"font-size: 20px;\">Explain procedures and answer questions.</span></p></li><li><p><span style=\"font-size: 20px;\">Reassure patients throughout their visit.</span></p></li><li><p><span style=\"font-size: 20px;\">Support anxious and vulnerable patients.</span></p></li><li><p><span style=\"font-size: 20px;\">Monitor patients during imaging and treatment.</span></p></li><li><p><span style=\"font-size: 20px;\">Ensure every patient receives safe, compassionate care.</span></p></li></ul><p><span style=\"font-size: 20px;\">Strong communication skills and empathy are essential.</span></p><p></p>",
                "shadow": "md",
                "ctaHref": "#",
                "heading": "Patient care",
                "ctaAlign": "right",
                "ctaLabel": "Learn more",
