              },
              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\">The Patient Experience Questionnaire includes questions about:</span></p><ul><li><p><span style=\"font-size: 20px;\">Your diagnosis, scan or treatment.</span></p></li><li><p><span style=\"font-size: 20px;\">Any concerns you had before your appointment.</span></p></li><li><p><span style=\"font-size: 20px;\">The information you received from healthcare professionals.</span></p></li><li><p><span style=\"font-size: 20px;\">Your experience during your visit.</span></p></li><li><p><span style=\"font-size: 20px;\">Whether your expectations were met.</span></p></li><li><p><span style=\"font-size: 20px;\">Advice you would give to future patients.</span></p></li></ul><p><span style=\"font-size: 20px;\">You can answer as many or as few questions as you wish.</span></p><p></p>",
                "colorRole": "default",
                "headingAs": "",
