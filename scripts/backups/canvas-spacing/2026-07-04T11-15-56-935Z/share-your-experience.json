              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\">Your feedback may help BNMS to:</span></p><ul><li><p><span style=\"font-size: 20px;\">Improve patient information and educational resources.</span></p></li><li><p><span style=\"font-size: 20px;\">Better prepare patients for nuclear medicine scans and treatments.</span></p></li><li><p><span style=\"font-size: 20px;\">Support Nuclear Medicine departments in improving patient care.</span></p></li><li><p><span style=\"font-size: 20px;\">Develop future patient videos and information materials.</span></p></li><li><p><span style=\"font-size: 20px;\">Understand what patients value most during their care.</span></p></li></ul><p></p>",
                "colorRole": "default",
                "headingAs": "",
                "bulletIcon": "fa-solid fa-arrow-right",
                "bulletIconSize": 15,
