              "locked": false,
              "content": {
                "html": "<p style=\"text-align: left;\"><span style=\"font-size: 20px;\">The British Nuclear Medicine Society (BNMS) is committed to improving the experience of patients and carers receiving nuclear medicine services.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">By sharing your experience, you can help departments across the UK better understand what matters most to patients, identify opportunities for improvement and support the development of future patient information and educational resources.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">Whether your experience was recent or several years ago, your feedback is valuable.</span></p><p style=\"text-align: left;\"></p>",
                "colorRole": "default",
                "bulletIcon": "",
                "bulletIconSize": null,
                "bulletIconColor": "",
