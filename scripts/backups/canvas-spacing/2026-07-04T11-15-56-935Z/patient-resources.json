              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\">Patient resources are available for many common nuclear medicine investigations and treatments, including:</span></p><ul><li><p><span style=\"font-size: 20px;\">Bone scans</span></p></li><li><p><span style=\"font-size: 20px;\">Heart scans</span></p></li><li><p><span style=\"font-size: 20px;\">Brain scans</span></p></li><li><p><span style=\"font-size: 20px;\">Lung scans</span></p></li><li><p><span style=\"font-size: 20px;\">Kidney investigations</span></p></li><li><p><span style=\"font-size: 20px;\">PET scans</span></p></li><li><p><span style=\"font-size: 20px;\">Thyroid scans</span></p></li><li><p><span style=\"font-size: 20px;\">Radioiodine treatment</span></p></li><li><p><span style=\"font-size: 20px;\">Other specialist nuclear medicine procedures</span></p></li></ul><p><span style=\"font-size: 20px;\">New resources are added regularly as they become available.</span></p><p></p>",
                "colorRole": "default",
                "bulletIcon": "fa-solid fa-arrow-right-long",
                "bulletIconSize": 15,
