              "locked": false,
              "content": {
                "html": "<p><span style=\"font-size: 20px;\">The Patient Resources directory includes:</span></p><ul><li><p><span style=\"font-size: 20px;\">Patient information leaflets</span></p></li><li><p><span style=\"font-size: 20px;\">Procedure guides</span></p></li><li><p><span style=\"font-size: 20px;\">Educational videos</span></p></li><li><p><span style=\"font-size: 20px;\">Downloadable PDF resources</span></p></li><li><p><span style=\"font-size: 20px;\">Information about common nuclear medicine scans and treatments</span></p></li><li><p><span style=\"font-size: 20px;\">Resources for parents and children</span></p></li><li><p><span style=\"font-size: 20px;\">Additional patient support information</span></p></li></ul><p></p>",
