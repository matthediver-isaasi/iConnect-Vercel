              "locked": false,
              "content": {
                "html": "<p style=\"text-align: center;\"><span style=\"font-size: 20px;\">The British Nuclear Medicine Society has developed a range of patient resources to help you understand nuclear medicine and prepare for your scan or treatment.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Whether you're attending for a diagnostic examination, receiving treatment or supporting a family member, our resources are designed to explain procedures clearly and answer many of the questions you may have before your appointment.</span></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">All patient resources are available through the BNMS Resource Directory, where you can browse or search for information relevant to your procedure.</span></p><p style=\"text-align: center;\"></p>",
                "colorRole": "default",
                "bulletIcon": "",
                "bulletIconSize": null,
