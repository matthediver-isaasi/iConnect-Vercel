              "locked": false,
              "content": {
                "html": "<p style=\"text-align: left;\"><span style=\"font-size: 20px;\">The Ros Breen Fund was established in memory of Ros Breen, Superintendent Radiographer in Nuclear Medicine at Southampton General Hospital.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">Ros made an outstanding contribution to nuclear medicine technology throughout her career. Today, the fund created in her memory continues to support the education and professional development of members of the BNMS Radiographers, Technologists and Nurses Group.</span></p><p style=\"text-align: left;\"><span style=\"font-size: 20px;\">Whether attending conferences, undertaking specialist training or visiting centres of excellence, the fund helps members continue learning, developing and sharing knowledge across the profession.</span></p><p style=\"text-align: left;\"></p>",
                "colorRole": "default",
                "bulletIcon": "",
                "bulletIconSize": null,
                "bulletIconColor": "",
                "bulletIconPadTop": null,
                "characterSpacing": null,
                "bulletIconPadLeft": null,
