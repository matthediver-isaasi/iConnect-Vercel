              "content": {
                "html": "<p><span style=\"font-size: 20px;\">The Ros Breen Fund may be used to support a wide range of professional development activities, including:</span></p><ul><li><p><span style=\"font-size: 20px;\">Conferences and scientific meetings</span></p></li><li><p><span style=\"font-size: 20px;\">Professional development courses</span></p></li><li><p><span style=\"font-size: 20px;\">Visits to centres of excellence in the UK or overseas</span></p></li><li><p><span style=\"font-size: 20px;\">Educational activities related to nuclear medicine</span></p></li><li><p><span style=\"font-size: 20px;\">Other projects supporting professional development</span></p></li></ul><p></p>",
