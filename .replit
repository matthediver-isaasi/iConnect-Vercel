modules = ["nodejs-20", "web", "python-3.11", "php-8.2", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "unzip", "pandoc", "tectonic"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-assistant-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "custom-object-crm-live"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stripe-address-mappings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "monthly-membership-activation"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test client/src/lib/heroImageFocus.test.mjs client/src/lib/attendeeJobTitle.test.mjs client/src/lib/eventCtaLabel.test.mjs client/src/lib/articleUrlParts.test.mjs client/src/lib/formPrefillGating.test.mjs client/src/lib/formHiddenReachability.test.mjs client/src/lib/formPaymentQuote.test.mjs client/src/lib/formPaymentReturn.test.mjs client/src/lib/cardSwipeAutoFocus.test.mjs client/src/lib/cardSwipeAutoFocus.hook.test.mjs client/src/lib/roleAccessMap.test.ts client/src/lib/sessionZoomLink.test.mjs client/src/lib/tbcBookingReplacement.test.mjs client/src/lib/canvasSymbolFrames.test.mjs client/src/components/help/HelpArticleContent.test.jsx client/src/components/branding/brandingShared.test.jsx client/src/components/canvas/AiCompositionRenderer.test.jsx client/src/components/staticpage/StaticHtmlPageRenderer.test.jsx client/src/components/email-builder/richTextEditorCompact.test.jsx client/src/components/events/zoomSessionConfigPicker.test.jsx api/_lib/helpArticleChunker.test.mjs client/src/components/booking/TbcAttendeeControls.test.jsx client/src/lib/eventAgendaPersistence.test.mjs client/src/lib/resourceVideoEmbed.test.mjs client/src/components/resources/resourceCardVideo.test.jsx client/src/lib/reservedPageSlug.test.mjs client/src/lib/setValueBooleanCoercion.test.mjs client/src/lib/canvasMemberGroupBlock.test.mjs client/src/components/canvas/blocks/MemberGroupBlockView.test.jsx client/src/lib/canvasMemberGroupCardsBlock.test.mjs client/src/hooks/useMemberGroupCards.test.mjs client/src/components/member-groups/MemberGroupCard.test.jsx client/src/components/member-groups/MemberGroupCard.interaction.test.jsx client/src/components/canvas/blocks/MemberGroupCardsBlockView.test.jsx api/public/member-group-members.test.mjs client/src/lib/automaticMembership.test.mjs scripts/import-bnms-honorary-members.test.mjs client/src/hooks/memberRelationshipLayout.test.mjs client/src/pages/customObjects/coreRelationshipAdapters.test.js"

[[workflows.workflow]]
name = "ai-assistant-tests"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test api/_lib/*.test.mjs api/dashboard/_lib/*.test.mjs api/forms/processApplicationTenantOrder.test.mjs api/forms/send-submission-email.test.mjs api/public/form-submission.repeatable.test.mjs api/public/formSubmissionProcessingOrigin.test.mjs client/src/components/canvas/autoHeightBake.test.mjs client/src/components/canvas/useAutoHeightBake.test.mjs client/src/lib/canvasA11y.test.mjs client/src/lib/canvasTypographyResponsive.test.mjs client/src/lib/aiCompositionRender.test.mjs client/src/lib/formEmbedEmailPipeline.test.mjs"

[[workflows.workflow]]
name = "custom-object-crm-live"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/verify-custom-object-relationship-list-live.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "stripe-address-mappings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test shared/formStripeAddressMappings.test.mjs api/_lib/formStripeAddress*.test.mjs api/_lib/formEntityCreationProvenance.test.mjs api/_lib/stripeInvoiceAddress.test.mjs api/_lib/formEntityPipelines.test.mjs api/_lib/formMonthlyCard*.test.mjs api/_lib/stripeMonthlyCard.test.mjs api/forms/processApplication*.test.mjs supabase/migrations/20261017_form_stripe_address_mapping_processing.test.mjs && npx tsx --test client/src/lib/formPaymentReturn.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "monthly-membership-activation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test api/_lib/formEntityPipelines.test.mjs api/_lib/formMonthlyCardCheckout.test.mjs api/_lib/formMonthlyCardFinalize.test.mjs api/_lib/formMonthlyDirectDebitCheckout.test.mjs api/_lib/formMonthlyDirectDebitFinalize.test.mjs api/_lib/stripeMonthlyCard.test.mjs api/_lib/gocardlessWebhookProcessor.test.mjs api/_lib/gocardlessDirectDebit.test.mjs api/_lib/membershipInstalmentInvoicing.test.mjs api/_lib/monthlyMembershipRecovery.test.mjs api/membership/monthly-recovery.test.mjs api/cron/reconcile-gocardless.test.mjs api/cron/reconcile-stripe-card-plans.test.mjs client/src/components/membership/MonthlyMembershipRecoveryCard.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
ZOHO_CRM_API_DOMAIN = "https://www.zohoapis.eu"
INTERNAL_API_SECRET = "f922dda6e15928142cdc288d4c68414eb879de814fafbcc7bd1ef79fa809299f"
GOCARDLESS_ENVIRONMENT = "sandbox"
GOCARDLESS_REDIRECT_BASE_URL = "https://dev.iconn.app"

[userenv.development]
VITE_DEFAULT_TENANT = "gsf"

[agent]
integrations = ["javascript_stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
