modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "unzip", "pandoc", "tectonic"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-assistant-tests"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test client/src/lib/attendeeJobTitle.test.mjs client/src/lib/eventCtaLabel.test.mjs client/src/lib/formPrefillGating.test.mjs client/src/lib/roleAccessMap.test.ts client/src/lib/sessionZoomLink.test.mjs client/src/components/help/HelpArticleContent.test.jsx client/src/components/branding/brandingShared.test.jsx client/src/components/canvas/AiCompositionRenderer.test.jsx client/src/components/staticpage/StaticHtmlPageRenderer.test.jsx client/src/components/email-builder/richTextEditorCompact.test.jsx client/src/components/events/zoomSessionConfigPicker.test.jsx api/_lib/helpArticleChunker.test.mjs"

[[workflows.workflow]]
name = "ai-assistant-tests"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test api/_lib/*.test.mjs api/dashboard/_lib/*.test.mjs api/forms/processApplicationTenantOrder.test.mjs client/src/components/canvas/autoHeightBake.test.mjs client/src/components/canvas/useAutoHeightBake.test.mjs client/src/lib/canvasA11y.test.mjs client/src/lib/canvasTypographyResponsive.test.mjs client/src/lib/aiCompositionRender.test.mjs"

[userenv]

[userenv.shared]
ZOHO_CRM_API_DOMAIN = "https://www.zohoapis.eu"
INTERNAL_API_SECRET = "f922dda6e15928142cdc288d4c68414eb879de814fafbcc7bd1ef79fa809299f"
GOCARDLESS_ENVIRONMENT = "sandbox"
GOCARDLESS_REDIRECT_BASE_URL = "https://dev.iconn.app"

[userenv.development]
VITE_DEFAULT_TENANT = "gsf"

[agent]
integrations = ["javascript_stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
